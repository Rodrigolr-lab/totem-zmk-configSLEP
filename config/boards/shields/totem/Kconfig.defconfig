# Dongle mode: the DONGLE (3rd XIAO, on USB) is the split CENTRAL and runs the
# keymap. BOTH halves are peripherals, so the left half is intentionally NOT
# central here. Only ever run ONE central at a time.
if SHIELD_TOTEM_LEFT

config ZMK_KEYBOARD_NAME
    default "TOTEM"

endif

if SHIELD_TOTEM_DONGLE

config ZMK_KEYBOARD_NAME
    default "TOTEM"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Two peripherals: left half + right half.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Room for both peripheral links plus host BT profiles (6 - 2 = 4 profiles,
# 0-3; profile 3 is PARK on the ADJ layer).
config BT_MAX_CONN
    default 6

config BT_MAX_PAIRED
    default 6

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT || SHIELD_TOTEM_DONGLE

config ZMK_SPLIT
    default y

endif
